# Получите API_ID и API_HASH на https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Токен бота от @BotFather
BOT_TOKEN=

# Числовой chat_id владельца. Узнайте его командой /start после запуска бота.
OWNER_CHAT_ID=

# Необязательно: дополнительные получатели уведомлений через запятую.
ADDITIONAL_RECIPIENT_CHAT_IDS=

# Необязательно: имя файлов сессии и базы данных
TELETHON_SESSION=collector
# Для Linux VM предпочтительна строка из export_string_session.py; не храните её в Git.
TELETHON_STRING_SESSION=
DATABASE_PATH=orders.sqlite3
SOURCES_PATH=sources.json
LOG_LEVEL=INFO

# false — отправлять только разовые заказы; true — также присылать вакансии
SEND_JOB_VACANCIES=false

# true — присылать контрактные, part-time и project-based вакансии
SEND_FREELANCE_VACANCIES=true

# Бесплатные публичные внешние источники. API-ключи и регистрация не нужны.
HIMALAYAS_ENABLED=true
HIMALAYAS_POLL_INTERVAL_MINUTES=1440
HIMALAYAS_MCP_ENABLED=false
HIMALAYAS_MCP_POLL_MINUTES=10
JOBICY_ENABLED=true
JOBICY_POLL_INTERVAL_MINUTES=60
REMOTIVE_ENABLED=true
REMOTIVE_POLL_INTERVAL_MINUTES=360

# Official Threads API: provide this value only through .env or a GitHub Secret.
THREADS_ENABLED=false
THREADS_POLL_INTERVAL_MINUTES=30
THREADS_ACCESS_TOKEN=


# Ассистент комментариев Threads.
# Рекомендуется отдельный Telegram-бот, чтобы не конфликтовать с Job Radar polling.
THREADS_COMMENT_BOT_TOKEN=
# Он сам ищет посты и генерирует черновики локально через Ollama,
# но публикация происходит только после кнопки в Telegram.
THREADS_COMMENTS_ENABLED=false
THREADS_COMMENT_SCAN_MINUTES=30
THREADS_COMMENT_QUERIES=фриланс,заказчик,клиент,монтаж,видеомонтаж,Blender,3D,3д,game dev,Unreal Engine,motion design,After Effects,портфолио,3D printing,нейросети,AI,freelance,video editing,client work,creative work
THREADS_COMMENT_OWN_USERNAME=

# Режим для личного ассистента: поиск через локальный браузер, ответ вручную.
# Не требует App Review / Tech Provider для threads_keyword_search.
THREADS_DISCOVERY_MODE=browser
THREADS_MANUAL_REPLY_ONLY=true
THREADS_BROWSER_PROFILE_DIR=threads_browser_profile
# На Windows используем обычный установленный Edge, а не автоматизационный Chromium.
THREADS_BROWSER_CHANNEL=msedge
# Пока оставьте false: после стабильного теста можно попробовать true.
THREADS_BROWSER_HEADLESS=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Vision-модель анализирует изображения и превью видео из найденных постов.
# Официальная qwen3-vl:4b занимает около 3.3 GB.
OLLAMA_VISION_MODEL=qwen3-vl:4b
